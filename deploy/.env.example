# Cấu hình TD Bakugan trên mini PC.
# 1. Chép file này thành deploy/.env:   cp .env.example .env
# 2. Điền giá trị thật. File .env KHÔNG được commit lên git, không gửi cho ai.
# 3. Khoá ngẫu nhiên tạo bằng lệnh:     openssl rand -base64 32

# ---------- Địa chỉ web ----------
# Có tên miền: ghi tên miền (Caddy tự xin HTTPS). Thử trong mạng nhà chưa có tên miền: ghi :80
SITE_ADDRESS=tdbakugan.vn
# Địa chỉ đầy đủ khách gõ vào trình duyệt (có https://). Thử trong mạng nhà: http://<IP mini PC>
PUBLIC_ORIGIN=https://tdbakugan.vn

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=tdbakugan
MYSQL_USER=tdbakugan

# ---------- Trợ lý AI (Google Gemini) ----------
# Lấy khoá tại https://aistudio.google.com/apikey. Để trống thì bot trả lời bằng bộ từ khoá.
GEMINI_API_KEY=
# Tuỳ chọn: ghim một model (VD gemini-2.5-flash). Để trống = tự chọn.
GEMINI_MODEL=

# ---------- Lưu trữ và sao lưu ----------
# Thư mục trên ổ mini PC chứa CSDL, ảnh / video, bản sao lưu.
DATA_DIR=/srv/tdbakugan
# Nơi chép thêm bản sao lưu: ổ cứng ngoài / USB đã gắn (để trống nếu chưa có).
BACKUP_EXTERNAL_DIR=
# Nơi ngoài nhà qua rclone (VD gdrive:tdbakugan-backup). Để trống nếu chưa cài rclone.
RCLONE_REMOTE=

# ---------- Khác ----------
LOG_LEVEL=info
# Web chạy dữ liệu giả lập tới giai đoạn 9 của kế hoạch. Đừng đổi khi chưa được báo.
VITE_USE_MOCK=true
