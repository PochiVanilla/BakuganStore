# Base URL của backend TypeScript (Node.js) sau này.
# Khi backend sẵn sàng: đặt VITE_API_BASE_URL và VITE_USE_MOCK=false,
# toàn bộ tầng services/api sẽ tự chuyển sang gọi HTTP thật.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_USE_MOCK=true

# Endpoint WebSocket cho đấu giá realtime (hook useAuctionSocket).
VITE_WS_URL=ws://localhost:4000/ws

# Trợ lý AI trong khung chat (Google Gemini, gói miễn phí).
# Lấy khoá tại https://aistudio.google.com/apikey — KHÔNG có tiền tố VITE_
# để khoá chỉ nằm ở server (Vercel Function api/chat-bot.ts), không lọt xuống trình duyệt.
# Trên Vercel: Settings → Environment Variables → thêm GEMINI_API_KEY rồi deploy lại.
GEMINI_API_KEY=
# Tuỳ chọn: ghim một model cụ thể (mặc định gemini-flash-latest).
# GEMINI_MODEL=gemini-2.5-flash
