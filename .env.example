# Chép file này thành .env.local để chạy web trên máy (npm run dev).
# Web và API luôn chung một địa chỉ: trên mini PC Caddy chuyển /api vào backend, trên máy
# lập trình thì Vite làm việc đó (DEV_API_PROXY bên dưới). Vì vậy base URL để "/api".
# Khi backend làm xong (giai đoạn 9 của kế hoạch) mới đặt VITE_USE_MOCK=false.
VITE_API_BASE_URL=/api
VITE_USE_MOCK=true
# Tuỳ chọn: "1" để dữ liệu mock chờ như gọi mạng thật (xem skeleton khi phát triển).
# VITE_MOCK_LATENCY=1

# Endpoint WebSocket cho đấu giá realtime (hook useAuctionSocket) — chỉ dùng khi VITE_USE_MOCK=false.
VITE_WS_URL=ws://localhost:3000/ws

# Trợ lý AI trong khung chat (Google Gemini, gói miễn phí).
# Lấy khoá tại https://aistudio.google.com/apikey — KHÔNG có tiền tố VITE_
# để khoá chỉ nằm ở server, không lọt xuống trình duyệt. Trên mini PC điền trong deploy/.env;
# bản tạm trên Vercel: Settings → Environment Variables → thêm GEMINI_API_KEY rồi deploy lại.
GEMINI_API_KEY=
# Tuỳ chọn: ghim một model cụ thể (mặc định gemini-flash-latest).
# GEMINI_MODEL=gemini-2.5-flash

# Lập trình trên máy: chuyển /api và /ws sang backend chạy ở cổng 4000 (backend/ → npm run dev).
# Để trống thì "npm run dev" tự chạy api/chat-bot.ts như trước (không cần backend).
# DEV_API_PROXY=http://localhost:4000
