# Cấu hình backend khi LẬP TRÌNH trên máy cá nhân.
# Chép thành backend/.env rồi điền hai mật khẩu. File .env không commit lên git.
# Mỗi ghi chú để ở dòng riêng (không viết ghi chú sau giá trị trên cùng một dòng).

NODE_ENV=development
PORT=4000
# Log dễ đọc trên màn hình (pretty) hay dạng JSON như trên mini PC (json)
LOG_FORMAT=pretty

# Web chạy bằng "npm run dev" ở cổng 3000; "npm run preview" ở cổng 4173
PUBLIC_ORIGIN=http://localhost:3000
EXTRA_ORIGINS=http://localhost:4173

# MySQL do backend/docker-compose.yml bật (cổng 3307 để không đụng MySQL khác trên máy)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=tdbakugan
DB_USER=tdbakugan
# Tự đặt mật khẩu bất kỳ (chỉ dùng trên máy này). Đặt rồi thì đừng đổi,
# muốn đổi phải xoá dữ liệu MySQL lập trình: docker compose down -v
DB_PASSWORD=
# Mật khẩu root của MySQL lập trình: bộ test cần quyền tạo / xoá CSDL tdbakugan_test
DB_ROOT_PASSWORD=

# Tuỳ chọn: khoá Gemini để thử trợ lý AI thật (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=
